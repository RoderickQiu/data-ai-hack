# Snyk (https://snyk.io) policy file.
#
# Empty on purpose. The five ignores that used to live here were all transitive
# findings under cognee 1.5.4 (the cognee notebook exec endpoint, diskcache's
# pickle.load, and three litellm proxy-server issues), none with an upstream fix.
# Cognee now runs as a managed cloud tenant and the package is no longer a
# dependency, so the whole subtree - and every finding under it - is gone.
#
# Verified 2026-09-11 with the policy file moved aside:
#   snyk test --file=requirements.txt --package-manager=pip --command=.venv/bin/python
#   -> 12 dependencies tested, no vulnerable paths found.
#
# Add a new ignore only with a reason and an expiry, so it gets re-checked.
version: v1.25.0
ignore: {}
patch: {}
