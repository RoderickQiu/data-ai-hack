# Slack surface. Copy to "Individual Development/.env" and fill in.
# The repo-root .env is loaded first, then this file overrides it, so shared
# service keys stay in one place and Slack secrets stay local to this folder.

# Bot token, from OAuth & Permissions after installing the app to the workspace.
SLACK_BOT_TOKEN=xoxb-...

# App-level token with the connections:write scope, from Basic Information ->
# App-Level Tokens. This is what Socket Mode dials out on; without it the bot
# starts but no button click ever arrives.
SLACK_APP_TOKEN=xapp-...

# Channel id (not name) - open the channel, Channel details, copy at the bottom.
SLACK_CHANNEL=C0123456789

# Inbound API the rest of the system posts digests and packs to.
SLACK_API_HOST=127.0.0.1
SLACK_API_PORT=8765
SLACK_API_TOKEN=change-me-before-tunnelling

# Where human responses go. The JSONL file is always written; the webhook is
# additional and optional - point it at the MCP server or the memory owner's
# endpoint the moment one exists.
SIGNAL_LOG=data/signals.jsonl
# SIGNAL_WEBHOOK_URL=http://127.0.0.1:8000/signal
# SIGNAL_WEBHOOK_TOKEN=
