# Project environment template. Copy to .env (already gitignored) and fill in
# the values marked <...>.
#
# Everything here is a credential or a connection string. There is no model
# configuration any more: cognee runs as a managed cloud tenant and owns its own
# LLM and embedding stack, so no gcloud login, no Vertex project, no
# EMBEDDING_DIMENSIONS to keep in sync with a vector store.

# ---------------------------------------------------------------------------
# Cognee Cloud
# ---------------------------------------------------------------------------
# One hosted tenant shared by the whole team, so we all read and write the same
# knowledge graph instead of five divergent local copies. Both values come from
# the "Connect your agent" panel in the Cognee dashboard.
#
# The tenant URL is per-tenant, not a shared api.cognee.ai host. Keep the scheme
# and no trailing slash; the paths below are appended as /api/v1/...
COGNEE_BASE_URL=https://tenant-<tenant-uuid>.aws.cognee.ai
# Sent as the X-Api-Key header. Verified 2026-09-11: this credential is NOT a
# bearer token. Authorization: Bearer <same value> returns 401 on every route.
COGNEE_API_KEY=<your-cognee-api-key>
# Default dataset for add / cognify / search. Dataset names only resolve to
# datasets owned by the caller; for a dataset shared with you, pass datasetIds.
COGNEE_DATASET=candidate

# ---------------------------------------------------------------------------
# RocketRide
# ---------------------------------------------------------------------------
# Development connection (managed): use for running, validating and iterating -
# use(), send/chat, monitors, the app dev loop.
ROCKETRIDE_URI=https://api.rocketride.ai:443
ROCKETRIDE_APIKEY=<your-rocketride-dev-api-key>

# Deployment target (managed): use for deploy.*, schedules, publishApp/submitApp,
# build logs. If these lines are absent, no deploy target is configured - ask the
# user; never deploy to the dev connection.
ROCKETRIDE_DEPLOY_URI=https://api.rocketride.ai:443
ROCKETRIDE_DEPLOY_APIKEY=<your-rocketride-deploy-api-key>

# ---------------------------------------------------------------------------
# Other services
# ---------------------------------------------------------------------------
# HydraDB cloud. The API key is the only secret; the rest is the connection
# string, split the way every client wants it. Check yours with:
#   python -c "from hydra_db import HydraDB; print(HydraDB(token='<key>').databases.list())"
HYDRADB_APIKEY=<your-hydradb-api-key>
HYDRADB_URL=https://api.hydradb.com
HYDRADB_API_VERSION=2
# "Database" is HydraDB's tenant. New accounts ship with default-tenant.
HYDRADB_DATABASE=default-tenant
HYDRADB_COLLECTION=default
# RocketRide's db_hydradb node reads HYDRA_DB_API_KEY (that spelling, with the
# underscore) when its api_key field is left blank. Same value as HYDRADB_APIKEY.
HYDRA_DB_API_KEY=<your-hydradb-api-key>

# hotdata.dev. The CLI reads HOTDATA_API_KEY with that exact spelling; a key
# under any other name leaves it on the stale browser session and it reports
# "session expired or revoked". The browser login and the API key are separate
# credentials, and the login is the one that expires.
HOTDATA_API_KEY=<your-hotdata-api-key>
# No default workspace is stored when you authenticate by key, so every hotdata
# command needs -w. Get yours from `hotdata workspaces list`.
HOTDATA_WORKSPACE_ID=<work...>
# Created by scripts/hotdata-setup.sh; `hotdata databases list` shows it.
HOTDATA_DATABASE_ID=<dbid...>
# SQL catalog alias: SELECT ... FROM <catalog>.public.<table>
HOTDATA_CATALOG=jobs

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
