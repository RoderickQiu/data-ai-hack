# Project environment template. Copy to .env (already gitignored) and fill in
# the values marked <...>.
#
# Note on precedence: cognee calls load_dotenv(override=True) at import and finds
# this project's .env by walking up from the venv, so values in .env WIN over
# variables exported in your shell. Edit .env, not your shell, to change models.
#
# Two ways to run cognee. Pick ONE and comment out the other:
#   Option A  Vertex AI (Gemini)          needs gcloud login on your machine
#   Option B  any OpenAI-compatible API   needs only a base URL and an API key

# ---------------------------------------------------------------------------
# RocketRide
# ---------------------------------------------------------------------------
# Development connection (managed): use for running, validating and iterating -
# use(), send/chat, monitors, the app dev loop.
ROCKETRIDE_URI=https://api.rocketride.ai:443
ROCKETRIDE_APIKEY=<your-rocketride-dev-api-key>

# Deployment target (managed): use for deploy.*, schedules, publishApp/submitApp,
# build logs. If these lines are absent, no deploy target is configured - ask the
# user; never deploy to the dev connection.
ROCKETRIDE_DEPLOY_URI=https://api.rocketride.ai:443
ROCKETRIDE_DEPLOY_APIKEY=<your-rocketride-deploy-api-key>

# ===========================================================================
# OPTION A: Vertex AI (Gemini)
# ===========================================================================
# Model choices verified against Google's model list on 2026-09-10:
#   LLM        gemini-3.8-flash    GA since 2026-09-02, newest general-purpose model
#   Embedding  gemini-embedding-2  GA, 3072-dim, 8192-token input
# Both are served only from the "global" location, so VERTEXAI_LOCATION=global
# is required. Regional locations such as us-central1 will 404 for these models.
#
# Auth uses Application Default Credentials (ADC). Run once:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <your-gcp-project-id>
# Alternatively point at a service-account key file:
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
VERTEXAI_PROJECT=<your-gcp-project-id>
VERTEXAI_LOCATION=global

# --- LLM (structured extraction, summarisation, query answering) -------------
# LLM_PROVIDER must be set explicitly: cognee cannot infer a provider from the
# "vertex_ai/" prefix and would raise ProviderNotDeducibleError without it.
# "gemini" only selects tokenizer/rate-limit defaults; routing is done by litellm
# from the model prefix.
LLM_PROVIDER=gemini
LLM_MODEL=vertex_ai/gemini-3.8-flash
# cognee refuses to start with an empty LLM_API_KEY, but Vertex AI ignores this
# value and authenticates with ADC. Any non-empty placeholder works.
LLM_API_KEY=vertex-uses-adc
# Leave LLM_ENDPOINT unset. Setting it switches litellm to a custom-proxy code
# path that expects a Gemini API key instead of ADC.
# Do NOT set LLM_TEMPERATURE. Gemini 3.6 Flash and later reject custom
# temperature / top_p / top_k and cognee only sends temperature when it is set.
LLM_MAX_COMPLETION_TOKENS=16384
# Alternative if you want the strongest model instead of the fastest. Gemini 3.1
# Pro is still published under a -preview ID (verified 2026-09-10):
# LLM_MODEL=vertex_ai/gemini-3.1-pro-preview

# --- Embeddings ---------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=vertex_ai/gemini-embedding-2
# Falls back to LLM_API_KEY when unset; kept explicit for clarity.
EMBEDDING_API_KEY=vertex-uses-adc
# gemini-embedding-2 defaults to 3072. Google recommends 768, 1536 or 3072
# (Matryoshka truncation). Must match the vector store; change only on a fresh DB.
EMBEDDING_DIMENSIONS=3072
EMBEDDING_MAX_COMPLETION_TOKENS=8192
# REQUIRED for gemini-embedding-2 on Vertex. litellm routes it through the
# embedContent endpoint, which fuses every input in a request into ONE vector.
# With the default batch of 100, cognee gets 1 vector back for 100 chunks and
# fails with "list index out of range" (surfaced as EmbeddingException 422).
# Batch size 1 sends one chunk per request; cognee still runs them concurrently.
EMBEDDING_BATCH_SIZE=1
# Concurrent embedding requests = this // EMBEDDING_BATCH_SIZE. Lower it if you
# see 429 quota errors from Vertex.
EMBEDDING_MAX_CONCURRENT_DATA_POINTS=50

# ===========================================================================
# OPTION B: any OpenAI-compatible API (no gcloud needed)
# ===========================================================================
# Works with the official OpenAI API, OpenRouter, Together, Groq, DeepSeek,
# a LiteLLM proxy, vLLM, LM Studio, Ollama's /v1 endpoint, etc.
# Verified 2026-09-10 against a local mock /v1 server (chat + embeddings).
# To use: comment out the Option A LLM_* / EMBEDDING_* lines and uncomment these.
#
# LLM_PROVIDER=custom
# Keep the "openai/" prefix. It tells litellm to speak the OpenAI chat protocol
# to LLM_ENDPOINT; everything after the slash is sent as the model name verbatim.
# LLM_MODEL=openai/<model-name-exactly-as-the-server-expects-it>
# Base URL up to and including /v1 (do not append /chat/completions).
# LLM_ENDPOINT=https://<host>/v1
# LLM_API_KEY=<your-api-key>
# LLM_MAX_COMPLETION_TOKENS=16384
# Structured output: models litellm recognises get a JSON-schema response_format;
# unknown model names fall back to {"type": "json_object"}, which most
# OpenAI-compatible servers accept. If yours rejects response_format entirely,
# set STRUCTURED_OUTPUT_FRAMEWORK=instructor.
# For the official OpenAI API use LLM_PROVIDER=openai, leave LLM_ENDPOINT unset,
# and pick a model such as cognee's default openai/gpt-5-mini.
#
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=<embedding-model-name>
# EMBEDDING_ENDPOINT=https://<host>/v1
# EMBEDDING_API_KEY=<your-api-key>
# REQUIRED: cognee cannot auto-detect the size of an unknown model and would
# silently assume 3072. Must match the vector store; change only on a fresh DB.
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_MAX_COMPLETION_TOKENS=8191
# EMBEDDING_BATCH_SIZE=100
# For the official OpenAI API: EMBEDDING_PROVIDER=openai,
# EMBEDDING_MODEL=openai/text-embedding-3-large, EMBEDDING_DIMENSIONS=3072,
# no EMBEDDING_ENDPOINT.

# ---------------------------------------------------------------------------
# Other services
# ---------------------------------------------------------------------------
HYDRADB_APIKEY=<your-hydradb-api-key>
HOTDATA_APIKEY=<your-hotdata-api-key>

# ---------------------------------------------------------------------------
# Storage (cognee defaults: local, no extra services required)
# ---------------------------------------------------------------------------
# GRAPH_DATABASE_PROVIDER=ladybug
# VECTOR_DB_PROVIDER=lancedb
# DB_PROVIDER=sqlite

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# Uncomment to see exactly what litellm sends to the provider while debugging.
# LITELLM_LOG=DEBUG
