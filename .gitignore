.rocketride/
.env
.venv/
.venv-python39-backup/
__pycache__/
*.pyc
data/job_snapshots/
data/state/
data/raw/
data/*.parquet
data/runs-backup-*.json
data/chart.html
# Built by `make dashboard` from the live tables. Generated, and it carries a
# real candidate's run history — the page falls back to its own sample when
# this is absent, so a clone without it still renders.
dashboard/data.json
# A curated feed for a video. Fabricated numbers must never sit in the repo
# where they could be taken for logged runs (DESIGN §7).
dashboard/sample-data.json

# .pipe files are committed with ${VAR} placeholders, never real keys —
# see rocketride/pipelines.py write_pipe_files(redact=True).

# Any file that carries credentials, not just the one named .env.
# A env file shared over chat lands here as e.g. DOC-20260911-WA0010.env,
# which the bare `.env` rule does not match.
*.env
.env.backup*
.gitignore